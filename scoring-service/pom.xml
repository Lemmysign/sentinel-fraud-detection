<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sentinel</groupId>
        <artifactId>sentinel-fraud-detection</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scoring-service</artifactId>
    <name>scoring-service</name>
    <description>
        AI-powered fraud risk scoring service.
        Consumes FraudScoredEvents from Kafka, sends them to
        Groq (Llama3.3 70B) via Spring AI for deep analysis,
        and publishes enriched FraudAlertEvents to fraud.alerts.
    </description>

    <!--
        Spring AI BOM
        Spring AI has its own release train separate from
        Spring Boot. Declaring the BOM here means all Spring AI
        dependencies use the same version automatically.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--
            Spring Boot Starter
            Declared explicitly because Spring AI BOM
            can override dependency resolution.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Kafka
            Consumes FraudScoredEvents from fraud.scored topic.
            Publishes FraudAlertEvents to fraud.alerts topic.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Spring AI — OpenAI starter
            Used to connect to Groq's OpenAI-compatible API.
            Groq runs Llama3.3 70B in the cloud — no local
            model installation required.
            base-url and api-key configured in
            application.properties pointing to Groq.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            sentinel-commons
            Provides FraudScoredEvent (consumed from Kafka),
            FraudAlertEvent (published to Kafka),
            RiskLevel and TransactionStatus enums.
        -->
        <dependency>
            <groupId>com.sentinel</groupId>
            <artifactId>sentinel-commons</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!--
            Actuator
            Kubernetes health check endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Validation
            Validates event objects consumed from Kafka.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Kafka Test
            Embedded Kafka for unit testing.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
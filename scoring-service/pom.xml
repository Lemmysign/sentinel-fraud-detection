<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sentinel</groupId>
        <artifactId>sentinel-fraud-detection</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>scoring-service</artifactId>
    <name>scoring-service</name>
    <description>
        AI-powered fraud risk scoring service.
        Consumes transactions from Kafka, sends them to
        Ollama via Spring AI, and returns a fraud score
        between 0 and 100.
    </description>

    <!--
        Spring AI BOM (Bill of Materials)
        Spring AI has its own release train separate from
        Spring Boot. We declare its version here so all
        Spring AI dependencies below use the same version
        without repeating it on each dependency.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <dependencies>

        <!--
            Kafka
            Consumes transactions from transactions.raw topic.
            Publishes scored results to fraud.scored topic.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Spring AI — Ollama
            This is what connects Spring Boot to Ollama.
            Provides the ChatClient bean that sends transaction
            data to the local LLM and receives a fraud
            risk assessment back.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>


        <!--
  sentinel-commons
  Provides shared Kafka event contracts and enums.
  Ensures all services use identical event classes
  — preventing serialization mismatches on Kafka.
-->
        <dependency>
            <groupId>com.sentinel</groupId>
            <artifactId>sentinel-commons</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>


        <!--
    Spring Boot Starter
    Provides SpringApplication, auto-configuration,
    and the core Spring Boot runtime.
    Needs to be declared explicitly because Spring AI BOM
    overrides some dependency resolution.
-->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>



        <!--
            Actuator
            Kubernetes health check endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Validation
            Validates transaction objects consumed from Kafka.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Kafka Test
            Embedded Kafka for unit testing.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sentinel</groupId>
        <artifactId>sentinel-fraud-detection</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rules-engine-service</artifactId>
    <name>rules-engine-service</name>
    <description>
        Evaluates incoming transactions against configurable
        fraud engine — velocity checks, amount thresholds,
        geographic anomalies, and device fingerprinting.
    </description>

    <dependencies>

        <!--
            Kafka
            Consumes from transactions.raw topic.
            Evaluates each transaction against fraud engine
            then publishes result to fraud.scored topic.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Actuator
            Kubernetes health check endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>



        <!--
    MaxMind GeoIP2
    Provides the DatabaseReader that loads GeoLite2-City.mmdb
    and resolves IP addresses to geographic coordinates.
-->
        <dependency>
            <groupId>com.maxmind.geoip2</groupId>
            <artifactId>geoip2</artifactId>
            <version>4.2.0</version>
        </dependency>




        <!--
            Validation
            Validates transaction objects consumed
            from Kafka before applying engine.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!--
sentinel-commons
Provides shared Kafka event contracts and enums.
Ensures all services use identical event classes
— preventing serialization mismatches on Kafka.
-->

        <!--
            sentinel-commons
            Provides TransactionEvent (consumed from Kafka)
            and FraudScoredEvent (published to Kafka),
            plus RiskLevel and TransactionStatus enums.
        -->

        <dependency>
            <groupId>com.sentinel</groupId>
            <artifactId>sentinel-commons</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>



        <!--
            Spring Data Redis
            Used for velocity checks — counting transactions
            per account within a time window.
            Redis INCR and EXPIRE operations are atomic,
            making them thread-safe for concurrent requests
            without any locking on our side.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>



        <!--
            Kafka Test
            Embedded Kafka for unit testing rule evaluation
            without a real Kafka instance.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
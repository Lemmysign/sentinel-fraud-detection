<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sentinel</groupId>
        <artifactId>sentinel-fraud-detection</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>case-management-service</artifactId>
    <name>case-management-service</name>
    <description>
        Stores and manages flagged fraud cases.
        Exposes REST APIs for analysts to review,
        approve, or confirm transactions as fraud.
    </description>

    <dependencies>

        <!--
            Spring Web
            Exposes REST endpoints for the analyst dashboard
            to query, update, and resolve fraud cases.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA
            Maps fraud case objects to PostgreSQL database
            tables. Handles all database operations through
            repository interfaces — no raw SQL needed.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            PostgreSQL Driver
            The JDBC driver that connects Spring Data JPA
            to the PostgreSQL database running in Docker.
            scope=runtime means it's only needed at runtime,
            not during compilation.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Kafka
            Consumes fraud.scored events from Kafka
            and creates cases for high-risk transactions.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Actuator
            Kubernetes health check endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <!--
    Spring Data Redis
    Used to increment recipient risk counters in Redis
    when an analyst confirms fraud on a case.
    Creates the feedback loop between case management
    and the rules engine.
-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>



        <!--
            Validation
            Validates request payloads on REST endpoints.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Swagger / OpenAPI
            Live API documentation for analysts and
            integrating systems at /swagger-ui/index.html
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!--
            Kafka Test
            Embedded Kafka for testing consumers
            without a real Kafka instance.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!--
        sentinel-commons
        Provides shared Kafka event contracts and enums.
        Ensures all services use identical event classes
        — preventing serialization mismatches on Kafka.
        -->
        <dependency>
            <groupId>com.sentinel</groupId>
            <artifactId>sentinel-commons</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
        </dependency>


    </dependencies>

</project>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sentinel</groupId>
        <artifactId>sentinel-fraud-detection</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>feedback-service</artifactId>
    <name>feedback-service</name>
    <description>
        Consumes analyst decisions from Kafka and publishes
        feedback events to improve fraud model accuracy
        over time.
    </description>

    <dependencies>

        <!--
            Kafka
            Consumes model.feedback topic — analyst verdicts
            on flagged cases feed back into the system here.
            This is what closes the learning loop in Sentinel.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!--
            Actuator
            Kubernetes health check endpoint.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Kafka Test
            Embedded Kafka for unit testing consumers.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>



        <!--
        sentinel-commons
        Provides shared Kafka event contracts and enums.
        Ensures all services use identical event classes
        — preventing serialization mismatches on Kafka.
        -->
        <dependency>
            <groupId>com.sentinel</groupId>
            <artifactId>sentinel-commons</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>


    </dependencies>

</project>